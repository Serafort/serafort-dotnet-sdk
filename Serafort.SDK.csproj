<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Title>Serafort SDK</Title>
    <Version>0.1.0</Version>
    <Authors>Serafort Team</Authors>
    <PackageId>Serafort.SDK</PackageId>
    <Description>Official .NET SDK for Serafort authentication — M2M (client-credentials) token caching with automatic refresh, and B2B OIDC token validation with multi-tenant RBAC claims.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Serafort/serafort-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Serafort/serafort-dotnet-sdk</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>serafort;authentication;oauth2;oidc;identity;auth;sdk</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Serafort.SDK.Tests\**" />
    <EmbeddedResource Remove="Serafort.SDK.Tests\**" />
    <None Remove="Serafort.SDK.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.12" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

</Project>
