#!/bin/sh
# Portable pre-commit hook for the Serafort .NET SDK.
#
# This is a pure .NET/NuGet project with no npm/Node.js involved, so Husky
# (an npm-ecosystem tool) does not apply here. This plain POSIX shell script,
# wired in via `git config core.hooksPath .githooks`, is the idiomatic
# dependency-free equivalent for a .NET project.
#
# Enable it once per clone with:
#   git config core.hooksPath .githooks

set -e

echo "[pre-commit] Checking dotnet format..."
dotnet format --verify-no-changes

echo "[pre-commit] Running dotnet build..."
dotnet build -c Release --nologo

echo "[pre-commit] Running dotnet test..."
dotnet test Serafort.SDK.Tests/Serafort.SDK.Tests.csproj -c Release --nologo

echo "[pre-commit] All checks passed."
